# Browser-visible API origins (build time). `bun run dev` falls back to the
# local stack ports when these are unset; production builds require them.
VITE_PIPESOR_INGESTION_URL=http://127.0.0.1:8081
VITE_PIPESOR_PIPELINE_URL=http://127.0.0.1:8082
VITE_PIPESOR_RECOMMENDATION_URL=http://127.0.0.1:8086
# Optional: GitHub App installation page used by "Manage repository access".
# VITE_PIPESOR_GITHUB_APP_INSTALL_URL=https://github.com/apps/<app-slug>/installations/new
